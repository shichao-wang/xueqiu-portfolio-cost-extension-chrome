{
  "manifest_version": 3,
  "name": "Xueqiu Portfolio Cost",
  "version": "1.0",
  "description": "Calculate and display the cost of your Xueqiu portfolio.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://xueqiu.com/P/ZH*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}